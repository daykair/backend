{
  "kind": "singleType",
  "collectionName": "company_settings",
  "info": {
    "singularName": "company-setting",
    "pluralName": "company-settings",
    "displayName": "Configuración de Empresa",
    "description": "Datos fiscales, logo e identidad corporativa de la empresa"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "commercialName": {
      "type": "string",
      "default": "Saodi"
    },
    "businessName": {
      "type": "string"
    },
    "rif": {
      "type": "string"
    },
    "logoIncludesTaxInfo": {
      "type": "boolean",
      "default": false
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "instagram": {
      "type": "string"
    },
    "receiptFooterNote": {
      "type": "text"
    }
  }
}

