{
  "kind": "collectionType",
  "collectionName": "sizes",
  "info": {
    "singularName": "size",
    "pluralName": "sizes",
    "displayName": "Size",
    "description": "Tallas opcionales por variante de color con stock y precio opcionales"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "sku": {
      "type": "string",
      "required": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "stock": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "price": {
      "type": "decimal",
      "required": false
    },
    "wholesalePrice": {
      "type": "decimal",
      "required": false
    },
    "costPrice": {
      "type": "decimal",
      "private": true,
      "required": false
    },
    "isDiscounted": {
      "type": "boolean",
      "default": false
    },
    "discount": {
      "type": "decimal",
      "default": 0
    },
    "color": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::color.color",
      "inversedBy": "sizes"
    },
    "warehouse_stocks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::warehouse-stock.warehouse-stock",
      "mappedBy": "size"
    },
    "inventory_movements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::inventory-movement.inventory-movement",
      "mappedBy": "size"
    }
  }
}

